{
  "manifest_version": 3,
  "name": "Hulu Ad Muter",
  "version": "1.0.0",
  "description": "Mutes ads on Hulu in your browser, then unmutes when the show comes back.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hulu Ad Muter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.hulu.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
